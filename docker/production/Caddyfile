{
    auto_https off
}

{$DTX_NODE_HOSTNAME} {
    tls /data/caddy/server-cert.pem /data/caddy/server-key.pem

    # Caddy terminates public HTTPS/WSS only. The upstreams remain TLS and
    # are authenticated with the operator-owned private CA.
    @realtime path /v1/realtime-sync*
    reverse_proxy @realtime https://realtime-gateway:9444 {
        transport http {
            tls_trust_pool file /data/caddy/private-ca.pem
            tls_server_name {$DTX_NODE_HOSTNAME}
        }
    }

    # Canonical public API routes use a positive, non-zero decimal version.
    # Keep MCP on the node upstream in this shared production template.
    @node path_regexp versioned_api ^/v[1-9][0-9]*/.*$
    reverse_proxy @node https://dtx-node:8443 {
        transport http {
            tls_trust_pool file /data/caddy/private-ca.pem
            tls_server_name {$DTX_NODE_HOSTNAME}
        }
    }

    # Public feed discovery and feed resources use their exact well-known
    # namespace and the same private-CA-authenticated node transport.
    @public_feed path_regexp public_feed ^/\.well-known/dirextalk/public/v1/[^/]+(/.*)?$
    reverse_proxy @public_feed https://dtx-node:8443 {
        transport http {
            tls_trust_pool file /data/caddy/private-ca.pem
            tls_server_name {$DTX_NODE_HOSTNAME}
        }
    }

    @mcp {
        method POST
        path_regexp mcp ^/mcp$
    }
    reverse_proxy @mcp https://dtx-node:8443 {
        transport http {
            tls_trust_pool file /data/caddy/private-ca.pem
            tls_server_name {$DTX_NODE_HOSTNAME}
        }
    }

    # This shared template cannot reach Agent Control's loopback Owner listener.
    # The provisioned-host template adds its separate explicit Owner allowlist
    # only after Caddy shares Agent Control's network namespace. Agent Control's
    # native TLS/mTLS listeners on 9443/9444/9445 stay private and are never
    # HTTP-terminated by Caddy.
}
