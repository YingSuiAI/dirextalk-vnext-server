safe-uint = 0..9007199254740991
uuid-v7 = tstr .size 36
identity-id = tstr .size (8..128)
digest = bstr .size 32
signature = bstr .size 64

realtime-client-frame-v1 = hello-v1 / heartbeat-v1 / sync-ack-v1 / ephemeral-v1
realtime-server-frame-v1 = hello-ack-v1 / invalidation-v1 / catch-up-required-v1 / heartbeat-ack-v1 / ack-ok-v1 / ephemeral-signal-v1

hello-v1 = { 1: 1, 2: 1, 3: safe-uint }
heartbeat-v1 = { 1: 1, 2: 2, 3: uuid-v7, 4: 1..9007199254740991 }
sync-ack-v1 = { 1: 1, 2: 3, 3: uuid-v7, 4: 1..9007199254740991, 5: safe-uint }
ephemeral-v1 = { 1: 1, 2: 4, 3: 1..3, 4: digest, 5: 1..10000, 6: bool }

hello-ack-v1 = {
  1: 1, 2: 1, 3: uuid-v7, 4: 1..9007199254740991,
  5: 1..9007199254740991, 6: safe-uint, 7: 15000, 8: 45000
}
invalidation-v1 = { 1: 1, 2: 2, 3: 1..9007199254740991, 4: 1..3, 5: digest }
catch-up-required-v1 = { 1: 1, 2: 3, 3: safe-uint }
heartbeat-ack-v1 = { 1: 1, 2: 4, 3: uuid-v7, 4: 1..9007199254740991, 5: int }
ack-ok-v1 = { 1: 1, 2: 5, 3: safe-uint }
ephemeral-signal-v1 = { 1: 1, 2: 6, 3: 1..3, 4: digest, 5: int }

identity-mailbox-pull-v2 = { 1: 2, 2: safe-uint, 3: 1..100 }
identity-mailbox-pull-receipt-v2 = {
  1: 2, 2: identity-id, 3: uuid-v7, 4: safe-uint,
  5: [* identity-mailbox-envelope-v2]
}
identity-mailbox-envelope-v2 = { 1: 1..9007199254740991, 2: uuid-v7, 3: bstr .size (1..262144), 4: int }
identity-mailbox-ack-v2 = { 1: 2, 2: safe-uint }
identity-mailbox-ack-receipt-v2 = { 1: 2, 2: identity-id, 3: uuid-v7, 4: safe-uint }

device-history-grant-v1 = {
  1: 1, 2: identity-id, 3: uuid-v7, 4: digest, 5: 1..9007199254740991,
  6: digest, 7: 1..3, 8: tstr .size (8..128), 9: digest, 10: int,
  11: signature, 12: signature
}
