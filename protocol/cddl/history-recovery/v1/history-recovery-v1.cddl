; V40 candidate-authorized, opaque multi-device history recovery.
digest = bstr .size 32
signature = bstr .size 64
uuid-v7 = tstr .size 36
identity-id = tstr .size 57
channel-id = tstr .size 57
utc-millis = 0..9007199254740991
safe-uint = 0..9007199254740991
safe-highwater = 0..9007199254740990
positive-sequence = 1..9007199254740991
recovery-scope = { 1: 1, 2: uuid-v7 } / { 1: 2, 2: channel-id }

history-recovery-unsigned-request-v1 = {
  1: 2,
  2: uuid-v7,                 ; candidate-generated request_id
  3: identity-id,
  4: uuid-v7,                 ; candidate device
  5: bstr .size 32,           ; candidate signing key
  6: bstr .size 32,           ; registered recipient encryption key
  7: safe-uint,               ; observed identity-log sequence
  8: digest,                  ; observed identity-log head
  9: 1,                       ; all_current_memberships
  10: utc-millis,
  11: utc-millis
}

history-recovery-signed-request-v1 = {
  1: 2, 2: uuid-v7, 3: identity-id, 4: uuid-v7,
  5: bstr .size 32, 6: bstr .size 32, 7: safe-uint, 8: digest,
  9: 1, 10: utc-millis, 11: utc-millis,
  12: signature               ; candidate signature over fields 1..11
}

; HTTP/QR carrier adds the candidate-held bearer capability outside the
; signature. Persistence retains only its domain-separated digest.
history-recovery-request-v1 = {
  1: 2, 2: uuid-v7, 3: identity-id, 4: uuid-v7,
  5: bstr .size 32, 6: bstr .size 32, 7: safe-uint, 8: digest,
  9: 1, 10: utc-millis, 11: utc-millis, 12: signature,
  13: bstr .size 32
}

key-package-publish-binding-v1 = {
  1: 1, 2: identity-id, 3: uuid-v7, 4: uuid-v7,
  5: positive-sequence, 6: digest, 7: utc-millis, 8: digest
}

scoped-key-package-publish-v2 = {
  1: 2, 2: identity-id, 3: uuid-v7, 4: uuid-v7,
  5: positive-sequence, 6: digest, 7: utc-millis,
  8: bstr .size (1..65536), 9: signature,
  10: digest,                 ; recovery request digest
  11: digest,                 ; exact recovery scope digest
  12: 1                       ; history_recovery
}

scoped-key-package-claim-v2 = {
  1: 2, 2: identity-id, 3: uuid-v7,
  4: digest, 5: digest, 6: 1
}

scoped-key-package-publish-receipt-v2 = {
  1: 1, 2: uuid-v7, 3: digest, 4: utc-millis
}
scoped-key-package-claim-receipt-v2 = scoped-key-package-publish-v2

; Origin-authenticated, redacted current-fact projection. This unsigned value
; is valid only for the exact TLS origin fetch that returned it and is never a
; portable authorization proof.
mls-v5-recovery-authorization-v1 = {
  1: 1,
  2: identity-id,
  3: uuid-v7,                 ; recovery request ID
  4: uuid-v7,                 ; candidate device
  5: uuid-v7,                 ; active controller device
  6: digest,                  ; exact current identity head
  7: digest,                  ; claimed scoped KeyPackage
  8: digest,                  ; recovery request
  9: digest,                  ; recovery scope
  10: uuid-v7,                ; active history provider
  11: 1..3,                   ; active_device / root / recovery authority
  12: tstr .size (8..128),    ; current authority identifier
  13: digest,                 ; exact history grant
  14: digest,                 ; ready attachment manifest
  15: digest,                 ; scoped package claim receipt
  16: utc-millis              ; earliest current-fact expiry
}

device-history-grant-unsigned-v2 = {
  1: 2, 2: identity-id, 3: uuid-v7, 4: digest, 5: digest,
  6: uuid-v7, 7: uuid-v7, 8: 1..3, 9: tstr .size (8..128),
  10: uuid-v7, 11: uuid-v7, 12: safe-highwater, 13: positive-sequence,
  14: digest, 15: digest, 16: digest, 17: utc-millis, 18: utc-millis,
  19: digest
}

device-history-grant-v2 = {
  1: 2, 2: identity-id, 3: uuid-v7, 4: digest, 5: digest,
  6: uuid-v7, 7: uuid-v7, 8: 1..3, 9: tstr .size (8..128),
  10: uuid-v7, 11: uuid-v7, 12: safe-highwater, 13: positive-sequence,
  14: digest, 15: digest, 16: digest, 17: utc-millis, 18: utc-millis,
  19: digest, 20: signature, 21: signature,
  22: bstr .size (1..262144) ; opaque encrypted offer only
}

device-history-grant-receipt-v2 = {
  1: 1, 2: uuid-v7, 3: uuid-v7, 4: positive-sequence, 5: utc-millis
}

identity-mailbox-pull-v3 = {
  1: 3, 2: safe-uint, 3: 1..100
}
identity-mailbox-live-segment-v3 = {
  1: 1, 2: positive-sequence, 3: uuid-v7,
  4: bstr .size (1..262144), 5: utc-millis
}
identity-mailbox-terminal-segment-v3 = {
  1: 2, 2: positive-sequence, 3: positive-sequence
}
identity-mailbox-segment-v3 =
  identity-mailbox-live-segment-v3 / identity-mailbox-terminal-segment-v3
identity-mailbox-pull-receipt-v3 = {
  1: 3, 2: identity-id, 3: uuid-v7,
  4: safe-uint, 5: safe-uint, 6: [* identity-mailbox-segment-v3]
}
