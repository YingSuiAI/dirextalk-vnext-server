; V41 catalog-indexed, request-isolated recovery KeyPackage V3.
digest = bstr .size 32
signature = bstr .size 64
uuid-v7 = tstr .size 36
identity-id = tstr .size 57
channel-id = tstr .size 57
positive-uint = 1..9007199254740991
utc-millis = 0..9007199254740991
recovery-scope = { 1: 1, 2: uuid-v7 } / { 1: 2, 2: channel-id }

key-package-publish-binding-v3 = {
  1: 3,
  2: identity-id,
  3: uuid-v7,                  ; directly added candidate device
  4: uuid-v7,                  ; package id
  5: uuid-v7,                  ; recovery request id
  6: digest,                   ; exact recovery request digest
  7: digest,                   ; signed catalog-head digest
  8: positive-uint,            ; catalog generation
  9: positive-uint,            ; exact catalog index
  10: digest,                  ; exact catalog leaf digest
  11: recovery-scope,
  12: digest,                  ; exact recovery-scope digest
  13: bstr .size 32,           ; candidate signing key
  14: positive-uint,           ; exact direct DeviceAdd H + 1
  15: digest,                  ; exact Identity Log head at H + 1
  16: utc-millis,
  17: digest                   ; opaque KeyPackage digest
}
key-package-publish-v3 = {
  1: key-package-publish-binding-v3,
  2: bstr .size (1..65536),
  3: signature
}
key-package-publish-receipt-v3 = {
  1: 3, 2: uuid-v7, 3: uuid-v7, 4: digest,
  5: positive-uint, 6: digest, 7: digest, 8: digest, 9: utc-millis
}
key-package-claim-v3 = {
  1: 3,
  2: identity-id,
  3: uuid-v7,
  4: digest,                   ; recovery request digest
  5: digest,                   ; catalog-head digest
  6: positive-uint,
  7: digest,                   ; catalog leaf digest
  8: digest                    ; recovery-scope digest
}
key-package-claim-receipt-v3 = {
  1: 3,
  2: uuid-v7,
  3: uuid-v7,
  4: digest,
  5: positive-uint,
  6: digest,
  7: digest,
  8: digest,
  9: bstr .size (1..131072),   ; exact original publish envelope
  10: digest,                  ; exact publish-envelope digest
  11: digest,                  ; exact claim-request digest
  12: utc-millis
}
