; Dirextalk Owner-approved Agent identity and opaque provisioning handoff V1.
sha256 = bstr .size 32
ed25519-signature = bstr .size 64
x25519-public-key = bstr .size 32
uuid-v7 = tstr .size 36
identity-id = tstr .size 57
safe-uint = 1..9007199254740991
utc-millis = -62135596800000..253402300799999

; Fields 1..15 form the canonical approval binding. Field 16 signs
; SHA-256("dirextalk.agent-identity-approval-binding.v1\0" || binding-cbor)
; under the exact current Owner device key, with signature input
; "dirextalk.agent-identity-approval-signature.v1\0" || binding-digest.
agent-identity-approval-binding-v1 = {
  1: 1,
  2: uuid-v7,       ; approval_id
  3: uuid-v7,       ; tenant_id
  4: uuid-v7,       ; installation_id
  5: uuid-v7,       ; binding_id
  6: uuid-v7,       ; tenant-scoped agent_device_id
  7: identity-id,   ; independent Agent identity
  8: uuid-v7,       ; Agent identity-log device
  9: safe-uint,      ; verified identity head sequence
  10: sha256,        ; verified identity head hash
  11: sha256,        ; server-recomputed Agent device credential fingerprint
  12: safe-uint,     ; expected installation revision
  13: identity-id,  ; authenticated installation Owner
  14: uuid-v7,      ; authenticated active Owner device
  15: utc-millis    ; approval expiry
}
agent-identity-approval-request-v1 = {
  1: agent-identity-approval-binding-v1,
  2: sha256,
  3: ed25519-signature
}
agent-identity-approval-receipt-v1 = {
  1: 1,
  2: uuid-v7,
  3: sha256,
  4: safe-uint,
  5: identity-id,
  6: uuid-v7,
  7: uuid-v7,
  8: uuid-v7,
  9: utc-millis
}

; The Connector signs a one-time sidecar-generated recipient. descriptor_digest
; is the Agent Control 1.3 COMMIT("dirextalk.agent-provisioning-recipient.v1",
; tenant UUID raw16, Connector UUID raw16, binding UUID raw16, installation UUID
; raw16, Agent Device UUID raw16, revision U64BE, recipient UUID raw16, X25519
; key, created U64BE, expires U64BE, credential UUID raw16, generation U64BE).
; The signature covers LP("dirextalk.agent-provisioning-recipient-signature.v1")
; followed by LP(descriptor_digest). The private key never enters Agent Control,
; server storage, an Owner client, argv, or env.
provisioning-recipient-descriptor-v1 = {
  1: 1,
  2: uuid-v7,       ; recipient_key_id
  3: uuid-v7,       ; tenant_id
  4: uuid-v7,       ; connector_id
  5: uuid-v7,       ; binding_id
  6: uuid-v7,       ; installation_id
  7: uuid-v7,       ; agent_device_id
  8: safe-uint,     ; provisioning revision
  9: x25519-public-key,
  10: uuid-v7,      ; authenticated Connector credential_id
  11: safe-uint,    ; Connector generation
  12: utc-millis,
  13: utc-millis,
  14: sha256,
  15: ed25519-signature
}

agent-provisioning-delivery-binding-v1 = {
  1: 1,
  2: uuid-v7,       ; delivery_id
  3: uuid-v7,       ; approval_id
  4: uuid-v7,       ; tenant_id
  5: uuid-v7,       ; installation_id
  6: uuid-v7,       ; binding_id
  7: uuid-v7,       ; agent_device_id
  8: identity-id,
  9: uuid-v7,       ; identity device_id
  10: safe-uint,    ; provisioning revision
  11: uuid-v7,      ; recipient_key_id
  12: sha256,       ; exact recipient descriptor digest
  13: sha256,       ; opaque capsule digest
  14: identity-id,  ; authenticated Owner
  15: uuid-v7,      ; authenticated Owner device
  16: utc-millis,
  17: utc-millis
}
agent-provisioning-delivery-request-v1 = {
  1: agent-provisioning-delivery-binding-v1,
  2: bstr .size (1..196608), ; HPKE-sealed capsule; server never decrypts it
  3: sha256,
  4: ed25519-signature
}
agent-provisioning-delivery-receipt-v1 = {
  1: 1,
  2: uuid-v7,
  3: uuid-v7,
  4: 1 / 2 / 3 / 4 / 5, ; pending/dispatched/installed/rejected/revoked
  5: sha256,
  6: safe-uint,
  7: sha256 / null,
  8: utc-millis
}

agent-provisioning-revocation-request-v1 = {
  1: 1,
  2: uuid-v7,
  3: uuid-v7,
  4: uuid-v7,
  5: safe-uint,
  6: identity-id,
  7: uuid-v7,
  8: 1 / 2,        ; installation / device
  9: utc-millis,
  10: sha256,
  11: ed25519-signature
}
agent-provisioning-revocation-receipt-v1 = {
  1: 1,
  2: uuid-v7,
  3: uuid-v7,
  4: uuid-v7,
  5: safe-uint,
  6: 1 / 2,
  7: sha256,
  8: utc-millis
}
