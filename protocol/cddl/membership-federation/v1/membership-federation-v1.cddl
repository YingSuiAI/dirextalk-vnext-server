; Dirextalk cross-node group authorization extension V1 (baseline V18).
;
; This extends, but does not rewrite, membership V1. Mutation bodies, action
; codes, routes, idempotency rules, and receipts remain those frozen by V17.
; A caller whose identity node differs from the group node omits
; DTX-Device-Session, sends DTX-Identity-Origin, and embeds the V2 proof below.

identity-id-v1 = tstr .size 57
uuid-v7-v1 = tstr .size 36
channel-id-v1 = tstr .size 57
sha256-digest-v1 = bstr .size 32
ed25519-signature-v1 = bstr .size 64
utc-millis-v1 = -62135596800000..253402300799999

private-conversation-scope-v1 = {
  1: 1,
  2: uuid-v7-v1
}

controlled-public-channel-scope-v1 = {
  1: 2,
  2: channel-id-v1
}

group-scope-v1 = private-conversation-scope-v1 / controlled-public-channel-scope-v1
group-action-v1 = 1 / 2 / 3 / 4 / 5 / 6 / 7

; Exact decoded relative path, without authority, query, fragment, alias, or
; trailing slash. Action 8 is reserved only for receipt queries.
canonical-group-path-v1 = tstr .size (1..512)

; A canonical origin is the URL origin ASCII serialization with lower-case
; scheme/host, explicit non-default port only, no userinfo, query, fragment,
; path, or trailing slash. Production accepts HTTPS only. An exact HTTP origin
; may be enabled explicitly by server configuration for isolated local tests.
canonical-identity-origin-v1 = tstr .size (8..512)

; Fields 7 and 8 retain the V17 idempotency-key and business-field digests.
; Field 11 binds the exact identity origin used to resolve the actor's active
; device key. The binding digest domain is
; `dirextalk.membership-action-binding.v2\0`; the Ed25519 signature input is
; `dirextalk.membership-action-signature.v2\0` followed by that digest.
federated-device-action-binding-v2 = {
  1: 2,
  2: group-action-v1,
  3: canonical-group-path-v1,
  4: group-scope-v1,
  5: identity-id-v1,
  6: uuid-v7-v1,
  7: sha256-digest-v1,
  8: sha256-digest-v1,
  9: utc-millis-v1,
  10: utc-millis-v1,
  11: canonical-identity-origin-v1
}

federated-device-action-proof-v2 = {
  1: 2,
  2: federated-device-action-binding-v2,
  3: ed25519-signature-v1
}

; A receipt GET never reuses a mutation proof. The client creates a fresh,
; short-lived proof with action 8 and the exact receipt path. The binding
; digest domain is `dirextalk.membership-receipt-query-binding.v2\0`; the
; Ed25519 signature input is
; `dirextalk.membership-receipt-query-signature.v2\0` plus that digest.
federated-receipt-query-binding-v2 = {
  1: 2,
  2: 8,
  3: canonical-group-path-v1,
  4: group-scope-v1,
  5: uuid-v7-v1,
  6: identity-id-v1,
  7: uuid-v7-v1,
  8: utc-millis-v1,
  9: utc-millis-v1,
  10: canonical-identity-origin-v1
}

federated-receipt-query-proof-v2 = {
  1: 2,
  2: federated-receipt-query-binding-v2,
  3: ed25519-signature-v1
}
