; Self-certifying identity log v1. This artifact is independent of the frozen
; tenant EventEnvelopeV1 contract under protocol/cddl/v1.

protocol-version = {
  1: 0..65535,
  2: 0..65535
}

identity-log-wire-version = {
  1: protocol-version,
  2: protocol-version
}

identity-id = tstr .size 57
uuid-v7 = tstr .size 36
sha256-digest = bstr .size 32
ed25519-public-key = bstr .size 32
device-encryption-public-key = bstr .size 32
ed25519-signature = bstr .size 64
utc-millis = -62135596800000..253402300799999
safe-uint = 0..9007199254740991
positive-safe-uint = 1..9007199254740991
relay-url = tstr .size (1..512)
key-acceptance-purpose-v1 = 1 / 2 / 3 / 4

genesis-recovery-acceptance-v1 = {
  1: identity-id,
  2: ed25519-public-key,
  3: ed25519-public-key
}

key-rotation-acceptance-v1 = {
  1: identity-id,
  2: positive-safe-uint,
  3: sha256-digest / null,
  4: key-acceptance-purpose-v1,
  5: ed25519-public-key
}

device-certificate-v1 = {
  1: identity-log-wire-version,
  2: identity-id,
  3: uuid-v7,
  4: ed25519-public-key,
  5: device-encryption-public-key,
  6: ed25519-public-key,
  7: utc-millis,
  8: ed25519-signature
}

relay-descriptor-v1 = {
  1: identity-log-wire-version,
  2: [1*8 relay-url],
  3: utc-millis
}

genesis-payload-v1 = {
  1: ed25519-public-key,
  2: ed25519-public-key,
  3: ed25519-signature
}

device-add-payload-v1 = {
  1: device-certificate-v1
}

device-revoke-payload-v1 = {
  1: uuid-v7
}

key-rotation-payload-v1 = {
  1: ed25519-public-key,
  2: ed25519-signature
}

recovery-restore-payload-v1 = {
  1: ed25519-public-key,
  2: ed25519-public-key,
  3: ed25519-signature,
  4: ed25519-signature
}

relay-descriptor-payload-v1 = {
  1: relay-descriptor-v1
}

identity-log-event-common-v1 = (
  1: identity-log-wire-version,
  2: identity-id,
  3: positive-safe-uint,
  4: sha256-digest / null,
  5: utc-millis,
  8: ed25519-public-key,
  9: ed25519-signature
)

identity-log-event-v1 =
  identity-log-genesis-event-v1 /
  identity-log-device-add-event-v1 /
  identity-log-device-revoke-event-v1 /
  identity-log-root-rotate-event-v1 /
  identity-log-recovery-rotate-event-v1 /
  identity-log-recovery-restore-event-v1 /
  identity-log-relay-descriptor-event-v1

identity-log-genesis-event-v1 = {
  identity-log-event-common-v1,
  6: 1,
  7: genesis-payload-v1
}

identity-log-device-add-event-v1 = {
  identity-log-event-common-v1,
  6: 2,
  7: device-add-payload-v1
}

identity-log-device-revoke-event-v1 = {
  identity-log-event-common-v1,
  6: 3,
  7: device-revoke-payload-v1
}

identity-log-root-rotate-event-v1 = {
  identity-log-event-common-v1,
  6: 4,
  7: key-rotation-payload-v1
}

identity-log-recovery-rotate-event-v1 = {
  identity-log-event-common-v1,
  6: 5,
  7: key-rotation-payload-v1
}

identity-log-recovery-restore-event-v1 = {
  identity-log-event-common-v1,
  6: 6,
  7: recovery-restore-payload-v1
}

identity-log-relay-descriptor-event-v1 = {
  identity-log-event-common-v1,
  6: 7,
  7: relay-descriptor-payload-v1
}
