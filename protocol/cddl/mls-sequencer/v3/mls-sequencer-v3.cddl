; Dirextalk MLS Commit Sequencer V3 approved-identity path (baseline V30).
; The server never decodes MLS Commit/Welcome plaintext. V2 remains readable.

uuid-v7 = tstr .size 36
identity-id = tstr .size 57
channel-id = tstr .size 57
sha256 = bstr .size 32
signature = bstr .size 64
safe-epoch = 0..9007199254740990
utc-millis = -62135596800000..253402300799999
scope = { 1: 1, 2: uuid-v7 } / { 1: 2, 2: channel-id }
origin = tstr .size (8..512)

approved-identity-join-v3 = {
  1: 2,
  2: uuid-v7, ; approval membership_command_id
  3: sha256,   ; approval authorization digest
  4: sha256,   ; candidate join request digest
  5: sha256    ; Owner/Admin approval request digest
}

mls-commit-request-v3 = {
  1: 3, 2: uuid-v7, 3: scope,
  4: identity-id, 5: uuid-v7,
  6: identity-id, 7: uuid-v7,
  8: sha256, 9: null,
  10: safe-epoch, 11: sha256,
  12: bstr .size (1..1048576), 13: sha256, 14: sha256,
  15: approved-identity-join-v3
}

; SHA-256(`dirextalk.mls-commit-request.v3\0` || exact transcript).
mls-request-digest-transcript-v3 = {
  1: 3, 2: uuid-v7, 3: scope, 4: identity-id, 5: uuid-v7,
  6: identity-id, 7: uuid-v7, 8: sha256, 9: sha256,
  10: safe-epoch, 11: sha256, 12: sha256, 13: sha256,
  14: 1, 15: uuid-v7, 16: sha256, 17: null, 18: null,
  19: sha256, 20: sha256
}

mls-commit-receipt-v3 = {
  1: 3, 2: uuid-v7, 3: scope, 4: sha256, 5: 1..9007199254740991,
  6: sha256, 7: sha256, 8: sha256, 9: identity-id, 10: uuid-v7,
  11: sha256, 12: sha256, 13: sha256
}
signed-mls-commit-receipt-v3 = {
  1: mls-commit-receipt-v3, 2: sha256, 3: bstr .size 32, 4: signature
}

; The stable confirmation body/signature remains the frozen V22 shape. A
; remote candidate additionally supplies a fresh proof in the header.
mls-device-join-confirmation-v3 = {
  1: 1, 2: uuid-v7, 3: identity-id, 4: uuid-v7,
  5: sha256, 6: sha256, 7: signature
}
mls-confirmation-binding-v3 = {
  1: 3, 2: 1, 3: tstr .size (1..512), 4: scope,
  5: uuid-v7, 6: identity-id, 7: uuid-v7, 8: sha256,
  9: utc-millis, 10: utc-millis, 11: origin
}
mls-confirmation-proof-v3 = {
  1: 3, 2: mls-confirmation-binding-v3, 3: signature
}
