; Self-authenticated identity bootstrap HTTP V1.
; The request body is the exact canonical signed genesis event defined by the
; frozen identity-log/v1_1 artifact. It is never decoded to JSON and reencoded.

identity-log-v1-1-protocol-version = {
  1: 1,
  2: 1
}

identity-log-v1-1-wire-version = {
  1: identity-log-v1-1-protocol-version,
  2: identity-log-v1-1-protocol-version
}

identity-id-v1-1 = tstr .size 57
sha256-digest-v1-1 = bstr .size 32
utc-millis-v1-1 = -62135596800000..253402300799999
positive-safe-uint-v1-1 = 1..9007199254740991

; Immutable receipt returned both when bootstrap first commits (201) and when
; an exact idempotent retry replays its original result (200).
identity-bootstrap-append-receipt-v1 = {
  1: 1,
  2: identity-id-v1-1,
  3: identity-log-v1-1-wire-version,
  4: positive-safe-uint-v1-1,
  5: sha256-digest-v1-1,
  6: sha256-digest-v1-1,
  7: 2,
  8: utc-millis-v1-1
}
