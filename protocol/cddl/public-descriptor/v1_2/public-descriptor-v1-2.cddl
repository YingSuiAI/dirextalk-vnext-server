; Current signed public Channel and Agent descriptor V1.2.
; V1.0 and V1.1 are frozen historical byte formats. They are never accepted
; by the current writer, current decoder, or reducer.
; `public-subject-id-v1-2` is constrained by the Rust verifier to a
; kind-matching self-certifying dtxc1 or dtxa1 ID derived from
; subject-genesis-signing-key-v1-2. It is never an internal tenant UUID,
; Matrix room ID, alias, feed path, or endpoint.
; V1.2 requires subject-genesis-signing-key-v1-2 to equal
; publisher-identity-genesis-signing-key-v1-2, so the publisher signature
; proves possession of the self-certifying subject authority.

public-descriptor-v1-2-protocol-version = {
  1: 1,
  2: 2
}

public-descriptor-v1-2-wire-version = {
  1: public-descriptor-v1-2-protocol-version,
  2: public-descriptor-v1-2-protocol-version
}

public-subject-id-v1-2 = tstr .size 57
identity-id-v1-2 = tstr .size 57
sha256-digest-v1-2 = bstr .size 32
ed25519-public-key-v1-2 = bstr .size 32
ed25519-signature-v1-2 = bstr .size 64
utc-millis-v1-2 = -62135596800000..253402300799999
positive-safe-uint-v1-2 = 1..9007199254740991
; Literal `https://dns-name[:non-default-port]` or the same with one root
; slash only. The Rust verifier requires canonical lower-case ASCII DNS labels
; (with at least one ASCII letter); it rejects IP literals, numeric/hex/octal
; WHATWG IPv4 forms, upper-case names, a trailing dot, userinfo, query,
; fragment, backslash, non-HTTPS, default port 443, leading-zero ports, and
; every non-root path. The fixed public feed path is:
; /.well-known/dirextalk/public/v1/{public-subject-id-v1-2}
public-feed-origin-v1-2 = tstr .size (1..512)

channel-payload-v1-2 = {
  1: public-feed-origin-v1-2,
  2: sha256-digest-v1-2
}

agent-payload-v1-2 = {
  1: public-feed-origin-v1-2,
  2: sha256-digest-v1-2,
  3: sha256-digest-v1-2
}

tombstone-payload-v1-2 = {}

public-descriptor-common-v1-2 = (
  1: public-descriptor-v1-2-wire-version,
  3: public-subject-id-v1-2,
  4: ed25519-public-key-v1-2,
  5: identity-id-v1-2,
  6: ed25519-public-key-v1-2,
  7: positive-safe-uint-v1-2,
  8: sha256-digest-v1-2 / null,
  9: utc-millis-v1-2,
  10: utc-millis-v1-2,
  13: ed25519-signature-v1-2
)

public-descriptor-v1-2 =
  public-channel-descriptor-v1-2 /
  public-agent-descriptor-v1-2 /
  public-channel-tombstone-v1-2 /
  public-agent-tombstone-v1-2

public-channel-descriptor-v1-2 = {
  public-descriptor-common-v1-2,
  2: 1,
  11: 1,
  12: channel-payload-v1-2
}

public-agent-descriptor-v1-2 = {
  public-descriptor-common-v1-2,
  2: 2,
  11: 2,
  12: agent-payload-v1-2
}

public-channel-tombstone-v1-2 = {
  public-descriptor-common-v1-2,
  2: 1,
  11: 3,
  12: tombstone-payload-v1-2
}

public-agent-tombstone-v1-2 = {
  public-descriptor-common-v1-2,
  2: 2,
  11: 3,
  12: tombstone-payload-v1-2
}
