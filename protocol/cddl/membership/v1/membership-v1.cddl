; Dirextalk group membership HTTP V1.
;
; This contract belongs to a tenant-affine `dtx-group-node`. The node selects
; its tenant from trusted server configuration and the authenticated active
; device session. A tenant identifier is deliberately not representable in an
; HTTP path, query, CBOR body, proof, or receipt.
;
; Every mutation body is exact canonical CBOR. A decoder must reject duplicate
; map keys, indefinite lengths, non-minimal integer/string encodings, and any
; byte sequence that does not round-trip byte-for-byte through the canonical
; encoder. The exact media types and HTTP routes are frozen in the paired
; OpenAPI document.

identity-id-v1 = tstr .size 57
channel-id-v1 = tstr .size 57
uuid-v7-v1 = tstr .size 36
sha256-digest-v1 = bstr .size 32
ed25519-signature-v1 = bstr .size 64
utc-millis-v1 = -62135596800000..253402300799999
nonnegative-safe-uint-v1 = 0..9007199254740991
positive-safe-uint-v1 = 1..9007199254740991
invite-use-limit-v1 = 1..4294967295
administrator-count-v1 = 0..5

; UUID values use their lower-case hyphenated RFC UUIDv7 spelling. An
; identity-id-v1 is a canonical lower-case `dtxi1` self-certifying identity;
; channel-id-v1 is a canonical lower-case `dtxc1` self-certifying channel.

; The two scopes remain disjoint even when a future implementation happens to
; store their values in the same physical database. `private-conversation`
; maps to the literal URL scope kind `private-conversation`; the public form
; maps to `controlled-public-channel`.
private-conversation-scope-v1 = {
  1: 1,
  2: uuid-v7-v1
}

controlled-public-channel-scope-v1 = {
  1: 2,
  2: channel-id-v1
}

group-scope-v1 = private-conversation-scope-v1 / controlled-public-channel-scope-v1

; The action number is included in the signed proof in addition to the exact
; route path, so a valid body cannot be transplanted to a different mutation.
; 1=create-group, 2=grant-admin, 3=revoke-admin, 4=issue-invite,
; 5=revoke-invite, 6=request-join, 7=approve-join.
group-action-v1 = 1 / 2 / 3 / 4 / 5 / 6 / 7
membership-command-kind-v1 = 1 / 2 ; request-join / approve-join

; This is the exact, decoded relative request path, not a route template. It
; begins with `/v1/groups/`, contains canonical unescaped path identifiers,
; and has no authority, query, fragment, percent-encoded alias, or trailing
; slash. The server reconstructs it from the HTTP request before verifying a
; proof.
canonical-group-action-path-v1 = tstr .size (1..512)

; Every mutation uses a device action proof. Field 7 is SHA-256 over literal
; ASCII `dirextalk.membership-idempotency-key.v1\0` followed by the raw ASCII
; Idempotency-Key header value. Field 8 is SHA-256 over literal ASCII
; `dirextalk.membership-action-business-fields.v1\0` followed by the
; canonical CBOR signable request defined below (the mutation body with its
; proof field omitted). Route-bound IDs are covered by fields 3 and 4.
;
; Field 9 is issued_at_ms and field 10 is expires_at_ms. The proof lifetime is
; strictly positive and no greater than 300000 milliseconds; the node also
; rejects a proof at or after expires_at_ms. Fields 5 and 6 must equal the
; identity and device obtained from the DTX-Device-Session, not merely a
; self-asserted body value.
device-action-binding-v1 = {
  1: 1,
  2: group-action-v1,
  3: canonical-group-action-path-v1,
  4: group-scope-v1,
  5: identity-id-v1,
  6: uuid-v7-v1,
  7: sha256-digest-v1,
  8: sha256-digest-v1,
  9: utc-millis-v1,
  10: utc-millis-v1
}

; The binding digest is SHA-256 over literal ASCII
; `dirextalk.membership-action-binding.v1\0` followed by canonical CBOR
; device-action-binding-v1. The signature verifies with the active device
; signing key over literal ASCII `dirextalk.membership-action-signature.v1\0`
; followed by that 32-byte binding digest. This digest is the approval
; authorization digest retained by the membership saga.
device-action-proof-v1 = {
  1: 1,
  2: device-action-binding-v1,
  3: ed25519-signature-v1
}

; Group creation has no body-selected owner: the session identity becomes the
; owner and first member. Its complete business input is the route-bound scope.
group-create-signable-v1 = {
  1: 1
}

group-create-request-v1 = {
  1: 1,
  2: device-action-proof-v1
}

; Only the current Owner can grant or revoke an additional administrator.
; There are at most five identities in addition to the Owner. The target admin
; identity is part of the signed exact route path, while the revision is part
; of the signable CBOR body.
grant-admin-signable-v1 = {
  1: 1,
  2: nonnegative-safe-uint-v1
}

grant-admin-request-v1 = {
  1: 1,
  2: nonnegative-safe-uint-v1,
  3: device-action-proof-v1
}

revoke-admin-signable-v1 = {
  1: 1,
  2: nonnegative-safe-uint-v1
}

revoke-admin-request-v1 = {
  1: 1,
  2: nonnegative-safe-uint-v1,
  3: device-action-proof-v1
}

; Owner and current Admins may issue and revoke invitations. `null` means the
; capability is not identity-targeted. The expiry is exclusive and must be
; strictly after the trusted node time at issuance; it is not the proof expiry.
issue-invite-signable-v1 = {
  1: 1,
  2: nonnegative-safe-uint-v1,
  3: (identity-id-v1 / null),
  4: invite-use-limit-v1,
  5: utc-millis-v1
}

issue-invite-request-v1 = {
  1: 1,
  2: nonnegative-safe-uint-v1,
  3: (identity-id-v1 / null),
  4: invite-use-limit-v1,
  5: utc-millis-v1,
  6: device-action-proof-v1
}

revoke-invite-signable-v1 = {
  1: 1,
  2: nonnegative-safe-uint-v1
}

revoke-invite-request-v1 = {
  1: 1,
  2: nonnegative-safe-uint-v1,
  3: device-action-proof-v1
}

; A candidate device creates a durable pending approval. Candidate identity and
; device come from the authenticated session and signed proof; the pending
; request ID is route-bound. `membership_command_id` remains stable across
; response loss and HTTP replay and is later used to query the receipt.
join-request-signable-v1 = {
  1: 1,
  2: uuid-v7-v1,
  3: uuid-v7-v1,
  4: nonnegative-safe-uint-v1,
  5: sha256-digest-v1
}

join-request-command-v1 = {
  1: 1,
  2: uuid-v7-v1,
  3: uuid-v7-v1,
  4: nonnegative-safe-uint-v1,
  5: sha256-digest-v1,
  6: device-action-proof-v1
}

; An Owner/Admin approval moves one pending request into a durable Sequencer
; intent. The candidate identity/device and invitation are repeated in the
; signed body so the approval cannot be redirected to a different member leaf
; or capability. The actor still comes only from the authenticated session and
; proof.
approve-join-signable-v1 = {
  1: 1,
  2: uuid-v7-v1,
  3: identity-id-v1,
  4: uuid-v7-v1,
  5: uuid-v7-v1,
  6: nonnegative-safe-uint-v1,
  7: sha256-digest-v1
}

approve-join-command-v1 = {
  1: 1,
  2: uuid-v7-v1,
  3: identity-id-v1,
  4: uuid-v7-v1,
  5: uuid-v7-v1,
  6: nonnegative-safe-uint-v1,
  7: sha256-digest-v1,
  8: device-action-proof-v1
}

; All non-membership mutations return this immutable receipt on first commit
; and exact idempotent replay. Field 4 is the verified device action binding
; digest, never the raw idempotency key or signature. Field 6 allows clients to
; display the Owner-excluded admin capacity without deciding authorization
; locally.
group-action-receipt-v1 = {
  1: 1,
  2: group-action-v1,
  3: group-scope-v1,
  4: sha256-digest-v1,
  5: nonnegative-safe-uint-v1,
  6: administrator-count-v1
}

; This transcript is retained for the durable MembershipCommand request digest.
; It is SHA-256 over literal ASCII
; `dirextalk.membership-command-request.v1\0` followed by canonical CBOR of
; this map. For a join request, field 12 is null. For an approval, field 12 is
; the verified device action binding digest from its action proof. The action
; proof separately binds Idempotency-Key, exact route, all body fields, actor
; device, and expiry; the command digest intentionally remains the durable
; saga/Sequencer idempotency digest.
membership-command-digest-transcript-v1 = {
  1: membership-command-kind-v1,
  2: uuid-v7-v1,
  3: group-scope-v1,
  4: identity-id-v1,
  5: uuid-v7-v1,
  6: uuid-v7-v1,
  7: identity-id-v1,
  8: uuid-v7-v1,
  9: uuid-v7-v1,
  10: nonnegative-safe-uint-v1,
  11: sha256-digest-v1,
  12: (sha256-digest-v1 / null)
}

; Membership receipt phases: 1=pending_approval, 2=pending_commit,
; 3=reconciling, 4=committed, 5=rejected. A caller must query a reconciling
; receipt rather than submit a new command. `already_member` is a committed
; disposition; it is never represented as an invitation-expired error.
membership-admission-disposition-v1 = 1 / 2 ; applied / already_member
membership-rejection-v1 = 1 / 2 / 3 ; policy_denied / stale_fence / admission_denied

membership-commit-reference-v1 = {
  1: 1,
  2: group-scope-v1,
  3: uuid-v7-v1,
  4: sha256-digest-v1,
  5: sha256-digest-v1
}

membership-receipt-pending-approval-v1 = {
  1: 1,
  2: uuid-v7-v1,
  3: sha256-digest-v1,
  4: 1
}

membership-receipt-pending-commit-v1 = {
  1: 1,
  2: uuid-v7-v1,
  3: sha256-digest-v1,
  4: 2
}

membership-receipt-reconciling-v1 = {
  1: 1,
  2: uuid-v7-v1,
  3: sha256-digest-v1,
  4: 3
}

membership-receipt-committed-v1 = {
  1: 1,
  2: uuid-v7-v1,
  3: sha256-digest-v1,
  4: 4,
  5: membership-admission-disposition-v1,
  6: membership-commit-reference-v1
}

membership-receipt-rejected-v1 = {
  1: 1,
  2: uuid-v7-v1,
  3: sha256-digest-v1,
  4: 5,
  5: membership-rejection-v1
}

membership-receipt-v1 = membership-receipt-pending-approval-v1 / membership-receipt-pending-commit-v1 / membership-receipt-reconciling-v1 / membership-receipt-committed-v1 / membership-receipt-rejected-v1
