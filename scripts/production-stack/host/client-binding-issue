#!/usr/bin/env bash
set -euo pipefail

if (( $# != 0 )); then
  echo 'usage: client-binding-issue' >&2
  exit 2
fi

if [[ "$(id -u)" != 0 ]]; then
  echo 'client-binding issuance requires root' >&2
  exit 1
fi

root=/etc/dirextalk/vnext/client-binding
staged=/home/ubuntu/dirextalk-client-binding.request
request="$root/request.json"
request_tmp="$root/request.json.tmp"
output="$root/import.json"
export=/home/ubuntu/dirextalk-client-binding.import.json
export_tmp="$root/import.json.export.tmp"
compose=/etc/dirextalk/vnext/config/production-compose.yml
env_file=/etc/dirextalk/vnext/config/production.env

[[ -f "$compose" && ! -L "$compose" ]] || { echo 'missing production compose' >&2; exit 1; }
[[ -f "$env_file" && ! -L "$env_file" ]] || { echo 'missing production env' >&2; exit 1; }
[[ -d /home/ubuntu && ! -L /home/ubuntu ]] || { echo 'missing ubuntu home' >&2; exit 1; }
[[ -f "$staged" && ! -L "$staged" ]] || { echo 'missing staged client-binding request' >&2; exit 1; }
[[ "$(stat -c '%u:%g:%a:%h' "$staged")" == '1000:1000:400:1' ]] || { echo 'staged request must be ubuntu:ubuntu 0400 with one link' >&2; exit 1; }
[[ -d "$root" && ! -L "$root" ]] || { echo 'missing client-binding directory' >&2; exit 1; }
[[ "$(stat -c '%u:%g:%a' "$root")" == '0:0:700' ]] || { echo 'client-binding directory must be root:root 0700' >&2; exit 1; }
[[ ! -e "$request_tmp" && ! -L "$request_tmp" ]] || { echo 'stale request staging artifact exists' >&2; exit 1; }
mv -T -- "$staged" "$request_tmp"
[[ -f "$request_tmp" && ! -L "$request_tmp" && "$(stat -c '%u:%g:%a:%h' "$request_tmp")" == '1000:1000:400:1' ]] || { echo 'staged request move is invalid' >&2; exit 1; }
chown 0:0 -- "$request_tmp"
chmod 0600 -- "$request_tmp"
[[ "$(stat -c '%u:%g:%a:%h' "$request_tmp")" == '0:0:600:1' ]] || { echo 'protected request staging is invalid' >&2; exit 1; }
mv -fT -- "$request_tmp" "$request"
[[ -f "$request" && ! -L "$request" && "$(stat -c '%u:%g:%a:%h' "$request")" == '0:0:600:1' ]] || { echo 'request artifact is invalid' >&2; exit 1; }
docker compose --project-name dirextalk-vnext-production \
  --env-file "$env_file" -f "$compose" \
  --profile client-binding run --rm --no-deps client-binding-issuer >/dev/null
[[ -f "$output" && ! -L "$output" && "$(stat -c '%u:%g:%a:%h' "$output")" == '0:0:600:1' ]] || { echo 'binding import artifact is invalid' >&2; exit 1; }
[[ ! -e "$export_tmp" && ! -L "$export_tmp" ]] || { echo 'stale export staging artifact exists' >&2; exit 1; }
install -o 0 -g 0 -m 0600 -- "$output" "$export_tmp"
chown 1000:1000 -- "$export_tmp"
chmod 0400 -- "$export_tmp"
[[ "$(stat -c '%u:%g:%a:%h' "$export_tmp")" == '1000:1000:400:1' ]] || { echo 'binding export staging is invalid' >&2; exit 1; }
mv -fT -- "$export_tmp" "$export"
[[ -f "$export" && ! -L "$export" && "$(stat -c '%u:%g:%a:%h' "$export")" == '1000:1000:400:1' ]] || { echo 'binding export artifact is invalid' >&2; exit 1; }
