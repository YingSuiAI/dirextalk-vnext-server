#!/usr/bin/env bash
set -euo pipefail

if (( $# != 0 )); then
  echo 'usage: client-binding-issue' >&2
  exit 2
fi

if [[ "$(id -u)" != 0 ]]; then
  echo 'client-binding issuance requires root' >&2
  exit 1
fi

root=/etc/dirextalk/vnext/client-binding
staged=/home/ubuntu/dirextalk-client-binding.request
request="$root/request.json"
request_tmp="$root/request.json.tmp"
output="$root/import.json"
export=/home/ubuntu/dirextalk-client-binding.import.json
export_tmp="$root/import.json.export.tmp"
compose=/etc/dirextalk/vnext/config/production-compose.yml
env_file=/etc/dirextalk/vnext/config/production.env

[[ -f "$compose" && ! -L "$compose" ]] || { echo 'missing production compose' >&2; exit 1; }
[[ -f "$env_file" && ! -L "$env_file" ]] || { echo 'missing production env' >&2; exit 1; }
[[ -d /home/ubuntu && ! -L /home/ubuntu ]] || { echo 'missing ubuntu home' >&2; exit 1; }
[[ -d "$root" && ! -L "$root" ]] || { echo 'missing client-binding directory' >&2; exit 1; }
[[ "$(stat -c '%u:%g:%a' "$root")" == '0:0:700' ]] || { echo 'client-binding directory must be root:root 0700' >&2; exit 1; }
command -v shred >/dev/null 2>&1 || { echo 'shred is required for client-binding replay cleanup' >&2; exit 1; }

valid_root_file() {
  local path=$1
  [[ -f "$path" && ! -L "$path" && "$(stat -c '%u:%g:%a:%h' "$path")" == '0:0:600:1' ]]
}
valid_staged_file() {
  local path=$1
  [[ -f "$path" && ! -L "$path" && "$(stat -c '%u:%g:%a:%h' "$path")" == '1000:1000:400:1' ]]
}
same_file() { cmp -s -- "$1" "$2"; }
request_has_fixed_ca() { grep -Fq -- '/run/dtx-client-binding/private-ca.pem' "$1"; }
normalize_request_tmp() {
  local state
  state=$(stat -c '%u:%g:%a:%h' "$request_tmp")
  case "$state" in
    1000:1000:400:1)
      chown 0:0 -- "$request_tmp"
      chmod 0600 -- "$request_tmp"
      ;;
    0:0:600:1) ;;
    *) echo 'request staging artifact is not a valid crash-boundary state' >&2; exit 1 ;;
  esac
  valid_root_file "$request_tmp" || { echo 'protected request staging is invalid' >&2; exit 1; }
}

request_present=0
if [[ -e "$request" || -L "$request" ]]; then
  valid_root_file "$request" || { echo 'request artifact is invalid' >&2; exit 1; }
  request_has_fixed_ca "$request" || { echo 'request CA path is not the fixed container path' >&2; exit 1; }
  request_present=1
fi
output_present=0
if [[ -e "$output" || -L "$output" ]]; then
  valid_root_file "$output" || { echo 'binding import artifact is invalid' >&2; exit 1; }
  output_present=1
fi

if [[ -e "$request_tmp" || -L "$request_tmp" ]]; then
  [[ ! -e "$request" && ! -L "$request" ]] || { echo 'request and staging artifacts coexist' >&2; exit 1; }
  [[ -f "$request_tmp" && ! -L "$request_tmp" ]] || { echo 'request staging artifact is invalid' >&2; exit 1; }
  normalize_request_tmp
  mv -fT -- "$request_tmp" "$request"
  valid_root_file "$request" || { echo 'request artifact is invalid' >&2; exit 1; }
  request_has_fixed_ca "$request" || { echo 'request CA path is not the fixed container path' >&2; exit 1; }
  request_present=1
fi

if [[ -e "$staged" || -L "$staged" ]]; then
  valid_staged_file "$staged" || { echo 'staged request is invalid' >&2; exit 1; }
  if (( request_present == 1 )); then
    same_file "$staged" "$request" || { echo 'staged request diverges from protected request' >&2; exit 1; }
    shred --remove=unlink -- "$staged" >/dev/null 2>&1
  else
    (( output_present == 0 )) || { echo 'live output exists without its protected request' >&2; exit 1; }
    [[ ! -e "$request_tmp" && ! -L "$request_tmp" ]] || { echo 'stale request staging artifact exists' >&2; exit 1; }
    mv -T -- "$staged" "$request_tmp"
    valid_staged_file "$request_tmp" || { echo 'staged request move is invalid' >&2; exit 1; }
    chown 0:0 -- "$request_tmp"
    chmod 0600 -- "$request_tmp"
    valid_root_file "$request_tmp" || { echo 'protected request staging is invalid' >&2; exit 1; }
    mv -fT -- "$request_tmp" "$request"
    valid_root_file "$request" || { echo 'request artifact is invalid' >&2; exit 1; }
    request_has_fixed_ca "$request" || { echo 'request CA path is not the fixed container path' >&2; exit 1; }
    request_present=1
  fi
fi
(( request_present == 1 )) || { echo 'missing protected or staged request' >&2; exit 1; }

if (( output_present == 0 )); then
  command -v docker >/dev/null 2>&1 || { echo 'docker is required for client-binding issuance' >&2; exit 1; }
  docker compose --project-name dirextalk-vnext-production \
    --env-file "$env_file" -f "$compose" \
    --profile client-binding run --rm --no-deps client-binding-issuer >/dev/null
  valid_root_file "$output" || { echo 'binding import artifact is invalid' >&2; exit 1; }
  output_present=1
fi

if [[ -e "$export_tmp" || -L "$export_tmp" ]]; then
  [[ -f "$export_tmp" && ! -L "$export_tmp" ]] || { echo 'export staging artifact is invalid' >&2; exit 1; }
  case "$(stat -c '%u:%g:%a:%h' "$export_tmp")" in
    0:0:600:1)
      chown 1000:1000 -- "$export_tmp"
      chmod 0400 -- "$export_tmp"
      ;;
    1000:1000:400:1) ;;
    *) echo 'export staging artifact is not a valid crash-boundary state' >&2; exit 1 ;;
  esac
  valid_staged_file "$export_tmp" || { echo 'binding export staging is invalid' >&2; exit 1; }
  same_file "$export_tmp" "$output" || { echo 'binding export staging diverges from protected output' >&2; exit 1; }
  if [[ -e "$export" || -L "$export" ]]; then
    valid_staged_file "$export" || { echo 'binding export artifact is invalid' >&2; exit 1; }
    same_file "$export_tmp" "$export" || { echo 'binding export diverges from protected output' >&2; exit 1; }
    shred --remove=unlink -- "$export_tmp" >/dev/null 2>&1
  else
    mv -fT -- "$export_tmp" "$export"
    valid_staged_file "$export" || { echo 'binding export artifact is invalid' >&2; exit 1; }
  fi
elif [[ -e "$export" || -L "$export" ]]; then
  valid_staged_file "$export" || { echo 'binding export artifact is invalid' >&2; exit 1; }
  same_file "$export" "$output" || { echo 'binding export diverges from protected output' >&2; exit 1; }
else
  [[ ! -e "$export_tmp" && ! -L "$export_tmp" ]] || { echo 'stale export staging artifact exists' >&2; exit 1; }
  install -o 0 -g 0 -m 0600 -- "$output" "$export_tmp"
  chown 1000:1000 -- "$export_tmp"
  chmod 0400 -- "$export_tmp"
  valid_staged_file "$export_tmp" || { echo 'binding export staging is invalid' >&2; exit 1; }
  mv -fT -- "$export_tmp" "$export"
  valid_staged_file "$export" || { echo 'binding export artifact is invalid' >&2; exit 1; }
fi
