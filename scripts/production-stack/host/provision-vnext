    if manifest['schema']!='dirextalk.vnext-stack-bundle' or manifest['schema_version']!=1 or manifest['target']!='linux-amd64': raise ContractError('installed release manifest schema invalid')
    if not isinstance(manifest['version'],str) or not SEMVER.fullmatch(manifest['version']) or not isinstance(manifest['source_commit'],str) or not HEX40.fullmatch(manifest['source_commit']): raise ContractError('installed release manifest version invalid')
    if any(not isinstance(manifest[k],str) or not VNET_IMAGE.fullmatch(manifest[k]) for k in ('server_image','migrator_image')) or not isinstance(manifest['installer_sha256'],str) or not HEX64.fullmatch(manifest['installer_sha256']): raise ContractError('installed release manifest image or installer invalid')
