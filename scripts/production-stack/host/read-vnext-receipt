#!/usr/bin/env python3
"""Validate and emit only the current canonical vNext install receipt."""

from __future__ import annotations

import hashlib
import json
import os
import re
import stat
import sys
from pathlib import Path

CURRENT_RECEIPT = Path("/var/lib/dirextalk-vnext/receipts/current.json")
SCHEMA = "dirextalk.vnext-installed-release"
MAX_RECEIPT_BYTES = 64 * 1024
HEX40 = re.compile(r"[0-9a-f]{40}")
HEX64 = re.compile(r"[0-9a-f]{64}")
SEMVER = re.compile(
    r"(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)"
    r"(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)"
    r"(?:\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?"
    r"(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?"
)
IMAGE = re.compile(r"dirextalk/vnet-server@sha256:[0-9a-f]{64}")
DOMAIN = re.compile(
    r"(?=.{1,253}\Z)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+"
    r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?"
)
KEYS = {
    "schema",
    "schema_version",
    "target",
    "domain",
    "version",
    "source_commit",
    "bundle_sha256",
    "manifest_sha256",
    "server_image",
    "migrator_image",
    "previous_receipt_sha256",
    "state",
    "installed_at_ms",
    "receipt_sha256",
}


class ReceiptError(RuntimeError):
    """The installed receipt cannot be trusted."""


def canonical(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def reject_duplicate_keys(pairs: list[tuple[str, object]]) -> dict[str, object]:
    result: dict[str, object] = {}
    for key, value in pairs:
        if key in result:
            raise ReceiptError("receipt contains a duplicate key")
        result[key] = value
    return result


def read_receipt() -> bytes:
    try:
        before = CURRENT_RECEIPT.lstat()
    except FileNotFoundError as error:
        raise ReceiptError("current receipt is missing") from error
    if (
        not stat.S_ISREG(before.st_mode)
        or before.st_uid != 0
        or before.st_gid != 0
        or stat.S_IMODE(before.st_mode) != 0o600
        or before.st_nlink != 1
        or before.st_size > MAX_RECEIPT_BYTES
    ):
        raise ReceiptError("current receipt owner, type, link count, mode, or size is invalid")
    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(CURRENT_RECEIPT, flags)
    try:
        opened = os.fstat(descriptor)
        if (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino):
            raise ReceiptError("current receipt changed before it was opened")
        chunks: list[bytes] = []
        size = 0
        while True:
            chunk = os.read(descriptor, min(8192, MAX_RECEIPT_BYTES + 1 - size))
            if not chunk:
                break
            size += len(chunk)
            if size > MAX_RECEIPT_BYTES:
                raise ReceiptError("current receipt exceeds its size bound")
            chunks.append(chunk)
        after = os.fstat(descriptor)
        if (after.st_dev, after.st_ino, after.st_size) != (opened.st_dev, opened.st_ino, opened.st_size):
            raise ReceiptError("current receipt changed while it was read")
        return b"".join(chunks)
    finally:
        os.close(descriptor)


def validate(raw: bytes) -> None:
    try:
        receipt = json.loads(raw, object_pairs_hook=reject_duplicate_keys)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ReceiptError("current receipt is not valid JSON") from error
    if not isinstance(receipt, dict) or set(receipt) != KEYS:
        raise ReceiptError("current receipt keys are not exact")
    if receipt.get("schema") != SCHEMA or receipt.get("schema_version") != 1:
        raise ReceiptError("current receipt schema is invalid")
    if receipt.get("target") != "linux-amd64":
        raise ReceiptError("current receipt target is invalid")
    if not isinstance(receipt.get("domain"), str) or DOMAIN.fullmatch(receipt["domain"]) is None:
        raise ReceiptError("current receipt domain is invalid")
    if not isinstance(receipt.get("version"), str) or SEMVER.fullmatch(receipt["version"]) is None:
        raise ReceiptError("current receipt version is invalid")
    if not isinstance(receipt.get("source_commit"), str) or HEX40.fullmatch(receipt["source_commit"]) is None:
        raise ReceiptError("current receipt source commit is invalid")
    for key in ("bundle_sha256", "manifest_sha256"):
        if not isinstance(receipt.get(key), str) or HEX64.fullmatch(receipt[key]) is None:
            raise ReceiptError(f"current receipt {key} is invalid")
    for key in ("server_image", "migrator_image"):
        if not isinstance(receipt.get(key), str) or IMAGE.fullmatch(receipt[key]) is None:
            raise ReceiptError(f"current receipt {key} is not immutable")
    previous = receipt.get("previous_receipt_sha256")
    if previous is not None and (not isinstance(previous, str) or HEX64.fullmatch(previous) is None):
        raise ReceiptError("current receipt previous digest is invalid")
    if receipt.get("state") not in ("installed", "rolled_back"):
        raise ReceiptError("current receipt state is invalid")
    installed_at = receipt.get("installed_at_ms")
    if isinstance(installed_at, bool) or not isinstance(installed_at, int) or installed_at < 0:
        raise ReceiptError("current receipt timestamp is invalid")
    receipt_hash = receipt.get("receipt_sha256")
    if not isinstance(receipt_hash, str) or HEX64.fullmatch(receipt_hash) is None:
        raise ReceiptError("current receipt digest is invalid")
    body = dict(receipt)
    del body["receipt_sha256"]
    if hashlib.sha256(canonical(body)).hexdigest() != receipt_hash or raw != canonical(receipt):
        raise ReceiptError("current receipt is not canonical or self-authenticating")


def main() -> int:
    if len(sys.argv) != 1:
        print("usage: read-vnext-receipt", file=sys.stderr)
        return 2
    try:
        raw = read_receipt()
        validate(raw)
    except (OSError, ReceiptError) as error:
        print(f"read-vnext-receipt: {error}", file=sys.stderr)
        return 1
    sys.stdout.buffer.write(raw)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
